<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="local.nupkgs" value="./src/nupkgs" />
	</packageSources>
	<packageSourceMapping>
        <packageSource key="local.nupkgs">
            <package pattern="Sa.*" />
        </packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>

    <!--
        NuGet Audit (.NET 10 audits transitive packages by default) needs vulnerability data.
        Query nuget.org only: the local folder feed never carries advisories.
    -->
    <auditSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </auditSources>

    <config>
        <add key="globalPackagesFolder" value="./.packages" />
    </config>
</configuration>
