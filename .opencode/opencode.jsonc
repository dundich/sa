{
  "$schema": "https://opencode.ai/config.json",
  // Project config for the Sa monorepo (.NET 10 Native AOT libraries; see AGENTS.md).
  //
  // Skills: this repo keeps its skills in .qwen/skills and .github/skills, which are
  // outside OpenCode's auto-discovery directory (.opencode/skills), so they are listed
  // here explicitly. Both directories share several skills (xunit, coverlet, ...);
  // .qwen/skills is listed first so same-named skills prefer it, and it also contains
  // the auto-* skills that .github/skills does not have.
  "skills": [
    "./.qwen/skills",
    "./.github/skills"
  ],
  "permissions": [
    // Layering note: project rules load BEFORE global rules, and the last matching rule
    // wins, so global catch-alls (shell *, edit *, webfetch *, ...) shadow project rules
    // for the same action. Project rules only take effect for actions the global config
    // does not cover (subagent, read, glob, grep tool, skill, question, execute, MCP tools).
    //
    // Allow the read-only explore subagent without prompting for codebase navigation.
    { "action": "subagent", "resource": "explore", "effect": "allow" }
  ]
}
