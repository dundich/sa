<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
	</PropertyGroup>

  <PropertyGroup>
    <NoWarn>1591;1701;1702;IDE1006;S3776</NoWarn>
  </PropertyGroup>

  <!--
    Shared xUnit runner config. xUnit treats every test class as its own collection and runs
    collections in parallel; in this repo most of those classes spin up a Testcontainers
    PostgreSQL (or Minio) instance in their fixture, so an unbounded default starts a dozen
    database containers at once and exhausts RAM on a normal dev machine.
    `maxParallelThreads` caps how many collections execute at the same time, which caps the number
    of live containers per test assembly. Raise it (or delete the file) on beefier machines / CI.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)xunit.runner.json"
          Link="xunit.runner.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />

    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>
  
  <ItemDefinitionGroup/>
  <ProjectExtensions/>
  <ImportGroup/>
</Project>
