<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Common.NuGet.Properties.xml" />

  <PropertyGroup>
    <Version>0.16.0</Version>
    <Description>File storage management</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sa.HybridFileStorage.FileSystemTests" />
    <InternalsVisibleTo Include="Sa.HybridFileStorageTests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Options + Options.ConfigurationExtensions дают AddOptions/Configure/PostConfigure/
      IValidateOptions/ValidateOnStart и BindConfiguration. Источник конфигурации
      (source-generated binder) включается в .NET SDK по умолчанию
      (EnableConfigurationBindingGenerator), поэтому BindConfiguration не тянет
      reflection и собирается под Native AOT — см. Sa.Media.FFmpeg/Setup.cs.
    -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sa.HybridFileStorage\Sa.HybridFileStorage.csproj" />
    <!-- File I/O (write/read/delete, path guard, cleanup activity) is delegated to the temp folder. -->
    <ProjectReference Include="..\Sa.Data.TempFolder\Sa.Data.TempFolder.csproj" />
  </ItemGroup>

</Project>
