<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="../Common.NuGet.Properties.xml" />

	<PropertyGroup>
		<Version>0.16.0</Version>
		<Title>Sa.Data.TempFolder</Title>
		<Description>Temporary directory management: path-guarded subfolders, debounced activity marking, age-based cleanup and low-priority volume tracking (Sa.Data.TempFolder)</Description>
		<PackageTags>temp temporary folder directory cleanup</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Sa.Data.TempFolderTests" />
	</ItemGroup>

	<ItemGroup>
		<!--
		  Retry.Linear для повторных попыток удаления. Retry.cs компилирует ExceptionExtensions.cs
		  (см. комментарий в самом Retry.cs) — оба файла линкуются, как в Sa.Data.PostgreSql.
		-->
		<Compile Include="..\Sa\Classes\Retry.cs" Link="AsLink\Retry.cs" />
		<Compile Include="..\Sa\Extensions\ExceptionExtensions.cs" Link="AsLink\ExceptionExtensions.cs" />
	</ItemGroup>

	<ItemGroup>
		<!--
		  Options + Options.ConfigurationExtensions дают AddOptions/Configure/PostConfigure/
		  IValidateOptions/ValidateOnStart и BindConfiguration. Hosting.Abstractions — BackgroundService
		  фоновой автоочистки. Источник конфигурации (source-generated binder) включается в .NET SDK
		  по умолчанию, поэтому BindConfiguration не тянет reflection и собирается под Native AOT.
		-->
		<PackageReference Include="Microsoft.Extensions.Options" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
	</ItemGroup>

</Project>
