<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Common.NuGet.Properties.xml" />

  <PropertyGroup>
    <Version>0.15.0</Version>
    <Description>File storage management in Pg</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Options + Options.ConfigurationExtensions дают AddOptions/Configure/IOptionsMonitor/
      BindConfiguration/IValidateOptions/ValidateOnStart для options-pipeline провайдера.
      Источник конфигурации (source-generated binder) включается в .NET SDK по умолчанию
      (EnableConfigurationBindingGenerator), поэтому BindConfiguration не тянет
      reflection и собирается под Native AOT — см. Sa.Media.FFmpeg/Setup.cs.
    -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
	<InternalsVisibleTo Include="Sa.HybridFileStorage.PostgresTests" />
  </ItemGroup>	

  <ItemGroup>
    <ProjectReference Include="..\Sa.HybridFileStorage\Sa.HybridFileStorage.csproj" />
    <ProjectReference Include="..\Sa.Partitional.PostgreSql\Sa.Partitional.PostgreSql.csproj" />
  </ItemGroup>

</Project>
