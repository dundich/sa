<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../Common.NuGet.Properties.xml" />

    <PropertyGroup>
        <Version>0.16.0</Version>
        <Description>Execute jobs on a schedule</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <NoWarn>1701;1702;</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <NoWarn>1701;1702;</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\Sa\Extensions\ExceptionExtensions.cs" Link="ExceptionExtensions.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Primitives" />
        <!--
          Options + Options.ConfigurationExtensions дают AddOptions /
          IValidateOptions / ValidateOnStart и BindConfiguration. Source-generated binder
          включается в .NET SDK автоматически при PublishAot=true, поэтому
          BindConfiguration не тянет reflection и собирается под Native AOT
          (включая Dictionary-свойства — проверено AOT-сборкой).
        -->
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Sa.ScheduleTests" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Sa.Utils.WorkQueue\Sa.Utils.WorkQueue.csproj" />
    </ItemGroup>

</Project>
