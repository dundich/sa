{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Schedule": {
    "Jobs": {
      "Heartbeat": {
        "Every": "00:00:02",
        "Immediate": true
      },
      "SlowReport": {
        "Disabled": true
      },
      "NightlyCleanup": {
        "Cron": "0 3 * * *"
      }
    }
  }
}
