<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../Common.NuGet.Properties.xml" />

    <PropertyGroup>
        <Version>0.16.0</Version>
        <Description>File storage management in S3</Description>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\Sa\Classes\MimeTypeMap.cs" Link="AsLink\MimeTypeMap.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sa.Data.S3\Sa.Data.S3.csproj" />
        <ProjectReference Include="..\Sa.HybridFileStorage\Sa.HybridFileStorage.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="AsLink\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Sa.HybridFileStorage.S3Tests" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Options + Options.ConfigurationExtensions дают AddOptions/Configure/PostConfigure/
          IValidateOptions/ValidateOnStart и BindConfiguration. Источник конфигурации
          (source-generated binder) включается в .NET SDK по умолчанию
          (EnableConfigurationBindingGenerator), поэтому BindConfiguration не тянет reflection
          и собирается под Native AOT.
        -->
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>

</Project>
