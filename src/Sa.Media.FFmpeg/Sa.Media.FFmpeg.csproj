<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../Common.NuGet.Properties.xml" />

    <PropertyGroup>
        <Version>0.16.0</Version>
        <Description>FFmpeg wrapper</Description>
        <GeneratePathProperty>true</GeneratePathProperty>
        <!-- Должно совпадать с $(FfmpegSupportedRids) в buildTransitive\Sa.Media.FFmpeg.Rid.props -->
        <RuntimeIdentifiers>win-x64;win-arm64;linux-x64</RuntimeIdentifiers>

        <!-- Пути для локальной работы -->
        <FfmpegSourceZipDir>$(MSBuildThisFileDirectory)sa</FfmpegSourceZipDir>
        <FfmpegLocalExtractDir>$(MSBuildThisFileDirectory)sa\native</FfmpegLocalExtractDir>
    </PropertyGroup>

    <!-- 🔹 RID: единый источник правды для сборки библиотеки и для потребителей пакета -->
    <Import Project="buildTransitive\Sa.Media.FFmpeg.Rid.props" />

    <!-- 🔹 ZIP-архивы как исходники -->
    <ItemGroup>
        <FfmpegZipFiles Include="$(FfmpegSourceZipDir)\**\ffmpeg.zip" />
        <None Include="@(FfmpegZipFiles)" Pack="false" Visible="false" />
    </ItemGroup>

    <!-- 🔹 Отладка выбора RID: dotnet build -p:SaFfmpegDebugRid=true -->
    <Target Name="DebugRid"
            BeforeTargets="ExtractFfmpegLocally"
            Condition="'$(SaFfmpegDebugRid)' == 'true'">
        <Message Text="[Sa.Media.FFmpeg] === RID Debug ===" Importance="high" />
        <Message Text="[Sa.Media.FFmpeg] RuntimeIdentifier:          '$(RuntimeIdentifier)'" Importance="high" />
        <Message Text="[Sa.Media.FFmpeg] NETCoreSdkRuntimeIdentifier: '$(NETCoreSdkRuntimeIdentifier)'" Importance="high" />
        <Message Text="[Sa.Media.FFmpeg] RequestedRid:               '$(_FfmpegRequestedRid)'" Importance="high" />
        <Message Text="[Sa.Media.FFmpeg] CurrentRid (payload):       '$(_FfmpegCurrentRid)'" Importance="high" />
        <Message Text="[Sa.Media.FFmpeg] Supported:                  $(FfmpegSupportedRids)" Importance="high" />
        <Message Text="[Sa.Media.FFmpeg] ===========================" Importance="high" />
    </Target>

    <!-- 🔹 Локальная распаковка: sa/<rid>/ffmpeg.zip → sa/native/ -->
    <Target Name="ExtractFfmpegLocally"
            BeforeTargets="BeforeBuild;CoreBuild"
            Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipFfmpegExtract)' != 'true' AND '$(_FfmpegCurrentRid)' != ''">

        <PropertyGroup>
            <_SourceZip>$(FfmpegSourceZipDir)\$(_FfmpegCurrentRid)\ffmpeg.zip</_SourceZip>
        </PropertyGroup>

        <Message Text="[Sa.Media.FFmpeg] 📦 Extracting FFmpeg for $(_FfmpegCurrentRid) → $(FfmpegLocalExtractDir)"
                 Importance="normal"
                 Condition="Exists('$(_SourceZip)')" />

        <MakeDir Directories="$(FfmpegLocalExtractDir)" />

        <Unzip SourceFiles="$(_SourceZip)"
               DestinationFolder="$(FfmpegLocalExtractDir)"
               SkipUnchangedFiles="true"
               OverwriteReadOnlyFiles="true"
               Condition="Exists('$(_SourceZip)')" />

        <!-- Execute bit для Unix. Failures are non-fatal: FFMpegLocator retries via File.SetUnixFileMode
             for the bundled payload only, and that produces a far clearer error than a chmod one. -->
        <Exec Command="chmod +x &quot;$(FfmpegLocalExtractDir)/ffmpeg&quot; &quot;$(FfmpegLocalExtractDir)/ffprobe&quot;"
              Condition="'$(OS)' != 'Windows_NT' AND Exists('$(FfmpegLocalExtractDir)/ffmpeg')"
              ContinueOnError="true" />
    </Target>

    <!--
      Нет бандла под этот RID. Сборка библиотеки не падает (в рантайме будет найден системный
      FFmpeg или FFMpegOptions.ExecutablePath), но предупреждение обязано быть громким: раньше
      таргет молча пропускался, если RID не совпадал с папкой payload'а.
    -->
    <Target Name="WarnMissingFfmpegPayload"
            BeforeTargets="ExtractFfmpegLocally"
            Condition="'$(SkipFfmpegExtract)' != 'true' AND '$(_FfmpegCurrentRid)' == ''">
        <Warning Text="[Sa.Media.FFmpeg] No bundled FFmpeg for RID '$(_FfmpegRequestedRid)'. Supported: $(FfmpegSupportedRids). Install FFmpeg system-wide or set FFMpegOptions.ExecutablePath. Pass -p:SkipFfmpegExtract=true to silence." />
    </Target>

    <!-- 🔹 Ключевое: делаем распакованные файлы видимыми для ProjectReference -->
    <Target Name="IncludeExtractedFfmpegFiles"
            AfterTargets="ExtractFfmpegLocally"
            BeforeTargets="GetCopyToOutputDirectoryItems;AssignTargetPaths"
            Condition="'$(SkipFfmpegExtract)' != 'true'">

        <ItemGroup Condition="Exists('$(FfmpegLocalExtractDir)')">
            <!--Находим все файлы в папке распаковки (без маркера .extracted-<rid>)-->
            <_ExtractedFfmpegFiles Include="$(FfmpegLocalExtractDir)\**\*"
                                  Exclude="$(FfmpegLocalExtractDir)\.extracted-*" />
        </ItemGroup>

        <!--Добавляем как Content с копированием - это работает для ProjectReference-->
        <ItemGroup Condition="'@(_ExtractedFfmpegFiles)' != ''">
            <Content Include="@(_ExtractedFfmpegFiles)"
                     Link="sa\native\%(RecursiveDir)%(FileName)%(Extension)"
                     CopyToOutputDirectory="PreserveNewest"
                     Pack="false"
                     Visible="false" />
        </ItemGroup>
    </Target>

    <!-- 🔹 .targets/.props для потребителей -->
    <ItemGroup>
        <None Include="buildTransitive\Sa.Media.FFmpeg.targets" Pack="true" PackagePath="buildTransitive\Sa.Media.FFmpeg.targets" />
        <None Include="buildTransitive\Sa.Media.FFmpeg.targets" Pack="true" PackagePath="build\Sa.Media.FFmpeg.targets" />
        <None Include="buildTransitive\Sa.Media.FFmpeg.Rid.props" Pack="true" PackagePath="ffmpeg\Sa.Media.FFmpeg.Rid.props" />
    </ItemGroup>

    <!-- 🔹 Упаковка ZIP в NuGet с RID-путём -->
    <ItemGroup>
        <None Include="$(FfmpegSourceZipDir)\**\ffmpeg.zip">
            <Pack>true</Pack>
            <PackagePath>ffmpeg</PackagePath>
            <Visible>false</Visible>
        </None>
    </ItemGroup>

    <!-- 🔹 Остальные настройки -->
    <ItemGroup>
        <InternalsVisibleTo Include="Sa.Media.FFmpegTests" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Options + Options.ConfigurationExtensions дают AddOptions/Configure/PostConfigure/
          IValidateOptions/ValidateOnStart и BindConfiguration. Источник конфигурации
          (source-generated binder) включается в .NET SDK по умолчанию
          (EnableConfigurationBindingGenerator), поэтому BindConfiguration не тянет
          reflection и собирается под Native AOT.
        -->
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    </ItemGroup>

</Project>
