<Project>

    <!-- Лежит рядом с payload'ом, а не в build/buildTransitive/, поэтому импортируется вручную:
         ответ зависит от $(RuntimeIdentifier), который известен только после тела проекта. -->
    <Import Project="$(MSBuildThisFileDirectory)..\ffmpeg\Sa.Media.FFmpeg.Rid.props"
            Condition="Exists('$(MSBuildThisFileDirectory)..\ffmpeg\Sa.Media.FFmpeg.Rid.props')" />

    <PropertyGroup>
        <_FfmpegRidFileMissing Condition="!Exists('$(MSBuildThisFileDirectory)..\ffmpeg\Sa.Media.FFmpeg.Rid.props')">true</_FfmpegRidFileMissing>
    </PropertyGroup>

    <!-- 🔹 определение RID у потребителя (см. Sa.Media.FFmpeg.Rid.props) -->
    <PropertyGroup>
        <_FfmpegRid>$(_FfmpegCurrentRid)</_FfmpegRid>
        <_FfmpegPkgRoot>$(MSBuildThisFileDirectory)..\</_FfmpegPkgRoot>
        <_FfmpegZip>$(_FfmpegPkgRoot)ffmpeg\$(_FfmpegRid)\ffmpeg.zip</_FfmpegZip>
        <_FfmpegDest>$(OutputPath)sa\native</_FfmpegDest>
        <_FfmpegMarker>$(_FfmpegDest)\.extracted-$(_FfmpegRid)</_FfmpegMarker>
    </PropertyGroup>

    <!--
      No bundled payload for this RID. The library still builds and runs — it falls back to a
      system FFmpeg or to FFMpegOptions.ExecutablePath — so this is a warning, not an error,
      but it must be loud: the previous behaviour (silently skipping the extraction because
      the distro-qualified RID did not match a payload folder) shipped broken packages.
    -->
    <Target Name="WarnMissingFfmpegPayload"
            BeforeTargets="Build;CoreBuild;GetCopyToOutputDirectoryItems"
            Condition="'$(SkipFfmpegExtract)' != 'true' AND '$(_FfmpegRidFileMissing)' == 'true'">
        <Error Text="[Sa.Media.FFmpeg] Broken package: ffmpeg\Sa.Media.FFmpeg.Rid.props is missing, so the RID cannot be resolved. Reinstall Sa.Media.FFmpeg, or pass -p:SkipFfmpegExtract=true and provide your own FFmpeg." />
    </Target>

    <Target Name="WarnUnsupportedFfmpegRid"
            BeforeTargets="Build;CoreBuild;GetCopyToOutputDirectoryItems"
            Condition="'$(SkipFfmpegExtract)' != 'true' AND '$(_FfmpegRidFileMissing)' != 'true' AND '$(_FfmpegRid)' == ''">
        <Warning Text="[Sa.Media.FFmpeg] No bundled FFmpeg for RID '$(_FfmpegRequestedRid)'. Supported: $(FfmpegSupportedRids). Install FFmpeg system-wide or set FFMpegOptions.ExecutablePath. Pass -p:SkipFfmpegExtract=true to silence." />
    </Target>

    <!-- 🔹 Распаковка при сборке потребителя -->
    <Target Name="ExtractFfmpegInConsumer"
            BeforeTargets="GetCopyToOutputDirectoryItems;AssignTargetPaths;Build;CoreBuild"
            Inputs="$(_FfmpegZip)"
            Outputs="$(_FfmpegMarker)"
            Condition="'$(SkipFfmpegExtract)' != 'true' AND Exists('$(_FfmpegZip)')">

        <Message Text="📦 [Sa.Media.FFmpeg] Extracting for RID $(_FfmpegRid)..."
                 Importance="normal" />
        <Message Text="📦 [Sa.Media.FFmpeg] Source=$(_FfmpegZip)"
                 Importance="normal" />
        <Message Text="📦 [Sa.Media.FFmpeg] Dest=$(_FfmpegDest)"
                 Importance="normal" />

        <MakeDir Directories="$(_FfmpegDest)" />

        <Unzip SourceFiles="$(_FfmpegZip)"
               DestinationFolder="$(_FfmpegDest)"
               SkipUnchangedFiles="true"
               OverwriteReadOnlyFiles="true"/>

        <!-- Создаем маркер завершения -->
        <Touch Files="$(_FfmpegMarker)" AlwaysCreate="true" />

        <!-- Для Linux/macOS -->
        <Exec Command="chmod +x &quot;$(_FfmpegDest)/ffmpeg&quot; &quot;$(_FfmpegDest)/ffprobe&quot;"
              Condition="'$(OS)' != 'Windows_NT'"
              ContinueOnError="true" />

        <!-- ДИНАМИЧЕСКОЕ ВКЛЮЧЕНИЕ В ЦЕПОЧКУ СБОРКИ -->
        <ItemGroup>
            <_FfmpegToInclude Include="$(_FfmpegDest)\**\*" Exclude="$(_FfmpegMarker)" />

            <Content Include="@(_FfmpegToInclude)">
                <!-- Link гарантирует сохранение пути sa\native в любом потребителе -->
                <Link>sa\native\%(RecursiveDir)%(FileName)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <Visible>false</Visible>
                <!-- Чтобы файлы не попали в чужие NuGet-пакеты случайно -->
                <Pack>false</Pack>
            </Content>
        </ItemGroup>

        <Message Text="[Sa.Media.FFmpeg] ✓ FFmpeg ready at $(_FfmpegDest)"
                 Importance="normal" />
    </Target>

    <!-- Очистка старых маркеров при смене RID -->
    <Target Name="CleanFfmpegMarkerOnRidChange"
            BeforeTargets="ExtractFfmpegInConsumer"
            Condition="'$(_FfmpegRid)' != ''">
        <ItemGroup>
            <_OldMarkers Include="$(_FfmpegDest)\.extracted-*"
                         Exclude="$(_FfmpegMarker)" />
        </ItemGroup>
        <Delete Files="@(_OldMarkers)" Condition="'@(_OldMarkers)' != ''" />
    </Target>

    <!-- Очистка при dotnet clean -->
    <Target Name="CleanFfmpegExtracted" AfterTargets="Clean" Condition="'$(_FfmpegDest)' != ''">
        <RemoveDir Directories="$(_FfmpegDest)" Condition="Exists('$(_FfmpegDest)')" />
        <Message Text="🧹 [Sa.Media.FFmpeg] Cleaned up native binaries at $(_FfmpegDest)"
                 Importance="low" />
    </Target>

</Project>
