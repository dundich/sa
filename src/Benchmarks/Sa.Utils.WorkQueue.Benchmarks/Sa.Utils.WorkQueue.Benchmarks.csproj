<Project Sdk="Microsoft.NET.Sdk">

    <!--
      A dependency-free benchmark harness. BenchmarkDotNet would be the better tool,
      but it is not in the local package feed; this project measures the same two
      numbers the queue's hot paths are judged by — wall time and allocated bytes —
      without adding a package to the repository.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- Not a test module: the solution is run with the Microsoft.Testing.Platform driver. -->
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Libraries\Misc\Sa.Utils.WorkQueue\Sa.Utils.WorkQueue.csproj" />
    </ItemGroup>

</Project>
