# Auto detect text files and perform LF normalization
*        text=lf
*        text eol=lf

# ...except binaries: EOL normalization rewrites bytes inside compressed streams, and the
# stored copy then no longer matches the file on disk. ffmpeg.zip was unreadable by zipfile
# in the repository (65 stray 0x0D bytes eaten out of the deflate data). Keep in sync with
# the repo-root .gitattributes.
*.zip    binary
*.mp3    binary
*.wav    binary
*.ogg    binary

*.cs     text diff=csharp
*.java   text diff=java
*.html   text diff=html
*.css    text
*.js     text
*.sql    text

*.csproj text merge=union

*.docx   diff=astextplain
*.DOCX   diff=astextplain

# absolute paths are ok, as are globs
/**/postinst* text eol=lf

# paths that don't start with / are treated relative to the .gitattributes folder
relative/path/*.txt text eol=lf

Sa.Media.FFmpeg/build/*.sh text eol=lf


