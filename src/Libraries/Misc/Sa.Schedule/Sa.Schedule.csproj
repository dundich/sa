<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Execute jobs on a schedule</Description>
        <PackageTags>scheduling jobs cron background</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\Sa\Extensions\ExceptionExtensions.cs" Link="ExceptionExtensions.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Primitives" />
        <!--
          Options + Options.ConfigurationExtensions дают AddOptions /
          IValidateOptions / ValidateOnStart и BindConfiguration. Source-generated binder
          включается через EnableConfigurationBindingGenerator=true
          (src/Libraries/Directory.Build.props), поэтому BindConfiguration не тянет
          reflection и собирается под Native AOT
          (включая Dictionary-свойства — проверено AOT-сборкой).
        -->
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Sa.ScheduleTests" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Sa.Utils.WorkQueue\Sa.Utils.WorkQueue.csproj" />
    </ItemGroup>

</Project>
