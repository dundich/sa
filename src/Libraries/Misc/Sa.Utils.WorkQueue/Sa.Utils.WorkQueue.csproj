<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Bounded work queue on top of System.Threading.Channels</Description>
        <PackageTags>queue channels concurrency backpressure</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Options + Options.ConfigurationExtensions дают AddOptions (named) /
          IValidateOptions / ValidateOnStart и BindConfiguration. Source-generated binder
          включается через EnableConfigurationBindingGenerator=true
          (src/Libraries/Directory.Build.props), поэтому BindConfiguration не тянет
          reflection и собирается под Native AOT.
        -->
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Sa.Utils.WorkQueue.Tests" />
    </ItemGroup>

</Project>
