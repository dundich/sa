<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Simple Outbox for Redis Streams (publishing and using messages)</Description>
		<PackageTags>outbox redis streams messaging</PackageTags>

		<!--
		  VerifyReference* are disabled for this project only: StackExchange.Redis 3.4.31 and its
		  transitive RESPite publish no IsTrimmable/IsAotCompatible assembly metadata in any
		  released version — there is no drop-in replacement, so this is an upstream gap rather
		  than a defect in our code. The library's own code is still covered by the
		  IsAotCompatible/IsTrimmable analyzers.
		-->
		<VerifyReferenceTrimCompatibility>false</VerifyReferenceTrimCompatibility>
		<VerifyReferenceAotCompatibility>false</VerifyReferenceAotCompatibility>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\..\Sa\Extensions\DateTimeExtensions.cs" Link="AsLink\DateTimeExtensions.cs" />
		<Compile Include="..\..\Sa\Extensions\ExceptionExtensions.cs" Link="AsLink\ExceptionExtensions.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="StackExchange.Redis" />
		<!-- IConfiguration is only read for the "Redis" connection string default. -->
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<!-- The settings type is a standard Microsoft.Extensions.Options instance. -->
		<PackageReference Include="Microsoft.Extensions.Options" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Sa.Outbox\Sa.Outbox.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Sa.Outbox.RedisTests" />
	</ItemGroup>

</Project>
