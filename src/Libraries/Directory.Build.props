<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>0.21.0</Version>

    <!--
      Libraries are consumed by Native AOT applications, so annotate them for AOT and
      trimming instead of setting PublishAot (a publishing property that belongs to the
      application, not to a class library).

      EnableConfigurationBindingGenerator is set explicitly: previously it was switched on
      implicitly by PublishAot=true, and the code relies on source-generated binding in
      BindConfiguration / IConfigurationSection.Bind calls.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!-- Source Link / symbol package (snupkg + SourceLink is the supported combination). -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--
      Ship IntelliSense: every public member is documented in source, so the XML file is
      packaged next to the assembly. Missing/broken doc comments are build warnings.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      Every package carries its own README (Readme.md next to the project) rather than the
      repository-level teaser: NuGet.org renders that file on the package page.
    -->
    <!--
      Package validation runs on `dotnet pack`: it checks that the package is well formed and
      that its runtime-specific assets agree. `PackageValidationBaselineVersion` is intentionally
      absent until the next release publishes a package to the feed — set it to that version then
      and breaking changes between releases fail the pack.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/dundich/Sa/releases</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Abstractions is enough: libraries register and resolve, they never build a provider. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Paths are resolved from this props file (src/Libraries/), not from the importing project. -->
    <None Include="$(MSBuildThisFileDirectory)../../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- The per-package Readme.md is packed in Directory.Build.targets (see the comment there). -->

</Project>
