<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shared source base: linked into consumers, never shipped as a package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SaTests" />
  </ItemGroup>

  <!--
    ConfigurationKey references Microsoft.Extensions.Configuration, which the base Sa package
    does not depend on. It is compiled into the packages that explicitly link it (Sa.Configuration,
    Sa.Configuration.PostgreSql), so exclude it from this project's default **/*.cs glob.
  -->
  <ItemGroup>
    <Compile Remove="Classes/ConfigurationKey.cs" />
  </ItemGroup>

</Project>
